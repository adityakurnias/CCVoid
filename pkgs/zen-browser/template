# Template file for 'zen-browser'
pkgname=zen-browser
version=1.23.4b
revision=2
archs="x86_64"
wrksrc="zen"
depends="gtk+3 dbus alsa-lib libXcomposite libXcursor libXdamage libXrandr
 libXi libxcb libglvnd libpulseaudio hicolor-icon-theme desktop-file-utils
 xdg-utils"
short_desc="Firefox-based browser focused on privacy and productivity"
maintainer="Kurnias <adityakurnia@proton.me>"
license="MPL-2.0"
homepage="https://zen-browser.app"
distfiles="https://github.com/zen-browser/desktop/releases/download/${version}/zen.linux-x86_64.tar.xz>zen-${version}.tar.xz"
checksum=ba81dd70af70d645f2f0a692f7fa4510f819290abfd8d8e60273d3d5a60d0536
nostrip=yes
noverifyrdeps=yes

do_install() {
	vmkdir usr/lib/zen-browser
	cp -a . "${DESTDIR}/usr/lib/zen-browser/"

	vinstall "${FILESDIR}/policies.json" 644 usr/lib/zen-browser/distribution

	vmkdir usr/bin
	ln -sf ../lib/zen-browser/zen "${DESTDIR}/usr/bin/zen-browser"

	for size in 16 32 48 64 128; do
		vinstall browser/chrome/icons/default/default${size}.png 644 \
			usr/share/icons/hicolor/${size}x${size}/apps zen-browser.png
	done

	vinstall "${FILESDIR}/zen-browser.desktop" 644 usr/share/applications
}
