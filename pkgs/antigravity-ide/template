# Template file for 'antigravity-ide'
pkgname=antigravity-ide
version=2.6.0
_build=5526304964083712
revision=1
archs="x86_64"
create_wrksrc=yes
depends="gtk+3 nss alsa-lib libXScrnSaver libxkbfile libsecret
 xdg-utils at-spi2-core libnotify libdrm"
short_desc="Google Antigravity agentic IDE"
maintainer="Kurnias <adityakurnia@proton.me>"
license="Proprietary"
homepage="https://antigravity.google"
restricted=yes
nostrip=yes
noverifyrdeps=yes
distfiles="https://edgedl.me.gvt1.com/edgedl/release2/j0qc3/antigravity/stable/${version}-${_build}/linux-x64/Antigravity%20IDE.tar.gz>antigravity-ide-${version}.tar.gz"
checksum=b060a7c7679103b2b619752f8ee7a3088dd241a7d207d4311974b56ea6f94356

do_install() {
	local _src="${wrksrc}/Antigravity IDE"
	[ -d "$_src" ] || _src="${wrksrc}"

	vmkdir usr/lib/antigravity-ide
	cp -a "${_src}/." "${DESTDIR}/usr/lib/antigravity-ide/"

	if [ -f "${DESTDIR}/usr/lib/antigravity-ide/chrome-sandbox" ]; then
		chmod 4755 "${DESTDIR}/usr/lib/antigravity-ide/chrome-sandbox"
	fi

	vmkdir usr/bin
	ln -sf ../lib/antigravity-ide/antigravity-ide "${DESTDIR}/usr/bin/antigravity-ide"

	vinstall "${_src}/resources/app/resources/linux/code.png" 644 \
		usr/share/icons/hicolor/512x512/apps antigravity-ide.png
	vinstall "${FILESDIR}/antigravity-ide.desktop" 644 usr/share/applications
}