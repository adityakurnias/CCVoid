# Template file for 'localsend'
pkgname=localsend
version=1.18.2
revision=1
archs="x86_64"
create_wrksrc=yes
nostrip=yes
noverifyrdeps=yes
depends="gtk+3 libayatana-appindicator libepoxy fontconfig
 xdg-user-dirs hicolor-icon-theme desktop-file-utils"
short_desc="Open source cross-platform alternative to AirDrop"
maintainer="Kurnias <adityakurnia@proton.me>"
license="Apache-2.0"
homepage="https://localsend.org"
distfiles="https://github.com/localsend/localsend/releases/download/v${version}/LocalSend-${version}-linux-x86-64.tar.gz"
checksum=287690a9a8eb6da9c83cc97b3e3030ac67daf32a7331fcf307d0939300658d16

do_install() {
	# RUNPATH is $ORIGIN/lib and Flutter looks for data/ next to the
	# executable, so keep the upstream layout intact.
	vmkdir usr/lib/localsend
	cp -a localsend_app data lib "${DESTDIR}/usr/lib/localsend/"

	vmkdir usr/bin
	ln -sf ../lib/localsend/localsend_app "${DESTDIR}/usr/bin/localsend"

	vinstall data/flutter_assets/assets/img/logo-128.png 644 \
		usr/share/icons/hicolor/128x128/apps localsend.png
	vinstall data/flutter_assets/assets/img/logo-256.png 644 \
		usr/share/icons/hicolor/256x256/apps localsend.png

	vinstall "${FILESDIR}/localsend.desktop" 644 usr/share/applications
}
