# Template file for 'noctalia-greeter'
pkgname=noctalia-greeter
version=1.7.0
revision=1
archs="x86_64* aarch64*"
build_style=meson
hostmakedepends="pkg-config wayland-devel"
makedepends="wayland-devel wayland-protocols wlroots0.20-devel libinput-devel
 libepoxy-devel libglvnd-devel MesaLib-devel cairo-devel pango-devel
 fontconfig-devel freetype-devel harfbuzz-devel librsvg-devel glib-devel
 libxkbcommon-devel libxml2-devel tomlplusplus-devel json-c++ stb
 libwebp-devel libjxl-devel"
depends="greetd dbus bash"
short_desc="A minimal login greeter for greetd that matches the look and feel of Noctalia Shell"
maintainer="Kurnias <adityakurnia@proton.me>"
license="MIT, Apache-2.0"
homepage="https://github.com/noctalia-dev/noctalia-greeter"
changelog="https://github.com/noctalia-dev/noctalia-greeter/releases"
distfiles="https://github.com/noctalia-dev/noctalia-greeter/archive/v${version}.tar.gz"
checksum=5b092784c0147bb6739efc2e8146d2d07e3572a59d7a370e93092f9f56d4fcc8
# Void's greetd package creates the system account "_greeter" (not "greeter").
# The state dir must be owned by it; apply-appearance resolves the greeter
# user from this directory's owner.
make_dirs="/var/lib/noctalia-greeter 0750 _greeter _greeter"

post_install() {
	rm -f "${DESTDIR}/usr/lib/tmpfiles.d/noctalia-greeter.conf"
	rmdir "${DESTDIR}/usr/lib/tmpfiles.d" 2>/dev/null || true

	vlicense LICENSE
	vlicense assets/fonts/tabler-icons-license.txt LICENSE.tabler-icons
	sed -n '/^\/\/ Copyright 2017 The Wuffs Authors\./,/^\/\/ SPDX-License-Identifier/p' \
		third_party/wuffs/wuffs-v0.4.c > LICENSE.wuffs
	vlicense LICENSE.wuffs
}
