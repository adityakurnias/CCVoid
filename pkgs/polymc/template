# Template file for 'polymc'
pkgname=polymc
version=8.0
revision=1
archs="x86_64"
build_style=cmake
configure_args="-DLauncher_QT_VERSION_MAJOR=6
 -DLauncher_BUILD_PLATFORM=voidlinux
 -DCMAKE_BUILD_TYPE=Release
 -DENABLE_LTO=OFF
 -DBUILD_TESTING=OFF
 -DCMAKE_Java_COMPILER=/usr/lib/jvm/openjdk17/bin/javac"
hostmakedepends="extra-cmake-modules openjdk17 pkg-config qt6-tools scdoc"
makedepends="qt6-base-devel qt6-svg-devel qt6-networkauth-devel
 qt6-charts-devel qt6-qt5compat-devel zlib-devel quazip-qt6-devel
 tomlplusplus-devel libarchive-devel qrencode-devel"
depends="virtual?java-runtime qt6-svg qt6-imageformats
 qt6-plugin-tls-openssl hicolor-icon-theme desktop-file-utils"
short_desc="Open source Minecraft launcher with support for multiple instances"
maintainer="Kurnias <adityakurnia@proton.me>"
license="GPL-3.0-only, Apache-2.0"
homepage="https://polymc.org"
distfiles="https://github.com/PolyMC/PolyMC/releases/download/${version}/PolyMC-${version}.tar.gz"
checksum=90ec4c2f47b342aa29a2441f97363c0863ed1fbddc4b8ef9a65e07cb36410ec3

wrksrc="PolyMC-${version}"

pre_configure() {
	export JAVA_HOME=/usr/lib/jvm/openjdk17
	export PATH="${JAVA_HOME}/bin:${PATH}"
	
	find . -name CMakeLists.txt -exec sed -i \
		-e 's/COMPILE_WARNING_AS_ERROR ON/COMPILE_WARNING_AS_ERROR OFF/g' \
		-e 's/-Werror//g' {} +
}