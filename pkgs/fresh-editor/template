# Template file for 'fresh-editor'
pkgname=fresh-editor
version=0.5.8
revision=1
archs="x86_64"
wrksrc="fresh-editor-x86_64-unknown-linux-gnu"
depends="hicolor-icon-theme"
short_desc="Terminal-based text editor with a modern UI"
maintainer="Kurnias <adityakurnia@proton.me>"
license="GPL-3.0-or-later"
homepage="https://getfresh.dev/"
distfiles="https://github.com/sinelaw/fresh/releases/download/v${version}/fresh-editor-x86_64-unknown-linux-gnu.tar.xz"
checksum=182787fe491b52a9a145ce25c934c654233b498665f100de44275a1ce98d45da

do_install() {
	vbin fresh
	vinstall fresh.desktop 644 usr/share/applications

	local size
	for size in 16x16 22x22 24x24 32x32 48x48 64x64 128x128 256x256 512x512; do
		vinstall "icons/${size}/apps/fresh.png" 644 \
			"usr/share/icons/hicolor/${size}/apps"
	done

	vlicense LICENSE
	vdoc README.md
}
